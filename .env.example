# Обязательно добавить это в .env и настроить, иначе prod не взлетит
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Необязательно. Сколько прокси перед приложением добавляют себя в X-Forwarded-For (по умолчанию 1)
TRUSTED_PROXY_HOPS=1

# Необязательно. Контакты на /contacts: почта и id пользователя, которому пишут «администрации».
# Не задан ключ — нет и карточки
CONTACT_EMAIL=hello@vibe.example
CONTACT_USER_ID=1

# Необязательно. Соль хеша гостя для счётчика просмотров (спека 43); по умолчанию — BETTER_AUTH_SECRET
VIEW_HASH_SALT=

# Необязательно. ИИ-ассистент модератора (спека 54). Без адреса Ollama (local) или ключа (anthropic) ИИ выключен
# AI_PROVIDER=local
# OLLAMA_URL=http://192.168.1.10:11434
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_NUM_CTX=32768
# OLLAMA_TIMEOUT_MS=180000
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODERATION_MODEL=claude-opus-5-5
# AI_MODERATION_EFFORT=low
# Помощник автора в редакторе (спека 55); пустой effort — параметр не отправляется
# AI_AUTHOR_MODEL=claude-haiku-5-5
# AI_AUTHOR_EFFORT=low
