# Обязательно добавить это в .env и настроить, иначе prod не взлетит
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Необязательно. Сколько прокси перед приложением добавляют себя в X-Forwarded-For (по умолчанию 1)
TRUSTED_PROXY_HOPS=1

# Необязательно. Контакты на /contacts: почта и id пользователя, которому пишут «администрации».
# Не задан ключ — нет и карточки
CONTACT_EMAIL=hello@vibe.example
CONTACT_USER_ID=1

# Необязательно. Соль хеша гостя для счётчика просмотров (спека 43); по умолчанию — BETTER_AUTH_SECRET
VIEW_HASH_SALT=
