# docker compose: скопируйте в .env и заполните.

# Подпись cookie сессий: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Адрес сайта, как его видит браузер
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000

# Необязательно: вход через GitHub (OAuth App, callback — <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Демо-данные в пустую базу при старте; в непустую сид ничего не пишет
SEED_ON_BOOT=true
